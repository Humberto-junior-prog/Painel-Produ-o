rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidProduct(data) {
      return data.productName is string && data.productName.size() <= 100
        && data.assignee is string && data.assignee.size() <= 100
        && (data.status == 'Pendente' || data.status == 'Concluído')
        && data.plans is map
        && data.history is map
        && data.quantity is number
        && data.order is number;
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(productId);
      allow update: if isSignedIn() && (
        incoming().diff(existing()).affectedKeys().hasOnly([
          'productName', 'assignee', 'unit', 'order', 'isNew', 
          'updatedAt', 'plans', 'history', 'status', 'quantity'
        ])
      );
      allow delete: if isSignedIn();
    }

    match /globalConfig/{configId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(configId);
    }
  }
}
